generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum League {
  NBA
  NFL
  CFB
  EPL
  LALIGA
  WORLD_CUP
}

enum GameStatus {
  SCHEDULED
  LIVE
  FINAL
  POSTPONED
  CANCELED
}

enum ParlayStatus {
  PENDING
  WON
  LOST
  PUSH
}

enum LegOutcome {
  PENDING
  WON
  LOST
  PUSH
}

enum MarketSide {
  YES
  NO
}

// legKind distinguishes what a leg is grading on. Today most legs are
// GAME_WINNER (the only kind the builder originally produced). Prop legs
// (player goals, team corners, …) carry an explicit kind so the settlement
// code routes them through the right grading path — without it, prop legs
// would fall through to the game-winner branch and silently be marked PUSH
// when the result obviously wasn't a PUSH, just a different question.
enum LegKind {
  GAME_WINNER
  PLAYER_GOALS
  TEAM_CORNERS
}

// propKind mirrors LegKind for the market side: a KalshiMarket's propKind
// tells the builder which scorer to use. Null means "this is a moneyline
// / game-winner market" — the default. Same vocabulary as LegKind (and
// parallel enum) so a leg's legKind can be derived from its market's propKind.
enum PropKind {
  PLAYER_GOALS
  TEAM_CORNERS
}

model Team {
  id           String   @id @default(cuid())
  league       League
  name         String
  shortName    String?
  externalId   String?  // provider's id for this team (one provider per league today)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  homeGames    Game[]   @relation("HomeTeam")
  awayGames    Game[]   @relation("AwayTeam")
  players      Player[]
  ratings      TeamRating[]
  teamStats    TeamGameStat[]

  @@unique([league, name])
  @@unique([league, externalId])
  @@index([league])
}

model Player {
  id          String   @id @default(cuid())
  league      League
  teamId      String?
  name        String
  position    String?
  externalIds String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team?    @relation(fields: [teamId], references: [id])
  stats       PlayerGameStat[]

  @@index([league])
  @@index([teamId])
}

model Game {
  id           String     @id @default(cuid())
  league       League
  startTime    DateTime
  status       GameStatus @default(SCHEDULED)
  homeTeamId   String
  awayTeamId   String
  homeScore    Int?
  awayScore    Int?
  externalId   String
  ratingApplied Boolean   @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  homeTeam     Team       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  playerStats  PlayerGameStat[]
  teamStats    TeamGameStat[]
  markets      KalshiMarket[]
  legs         ParlayLeg[]

  @@unique([league, externalId])
  @@index([league, startTime])
  @@index([status])
}

model PlayerGameStat {
  id        String  @id @default(cuid())
  gameId    String
  playerId  String
  points    Float?
  rebounds  Float?
  assists   Float?
  minutes   Float?
  // Soccer / World Cup player props (populated by syncPropStatsForLeague from
  // API-Football; null for basketball where it's irrelevant). Kept as a
  // dedicated column rather than dumped into `raw` so settlement can read it
  // without parsing JSON.
  goals     Float?
  raw       String  @default("{}") // JSON blob for provider-specific stats

  game      Game    @relation(fields: [gameId], references: [id])
  player    Player  @relation(fields: [playerId], references: [id])

  @@unique([gameId, playerId])
  @@index([playerId])
}

// Team-level box-score stats per game. v1 only stores corners; future
// prop kinds (shots, cards, …) add columns here. Kept separate from
// PlayerGameStat so a missing stat for a player doesn't block a team prop
// grade on the same game, and so we can put a unique index on (gameId, teamId)
// cleanly.
model TeamGameStat {
  id        String  @id @default(cuid())
  gameId    String
  teamId    String
  corners   Float?
  raw       String  @default("{}")

  game      Game    @relation(fields: [gameId], references: [id])
  team      Team    @relation(fields: [teamId], references: [id])

  @@unique([gameId, teamId])
  @@index([teamId])
}

model TeamRating {
  id        String   @id @default(cuid())
  teamId    String
  league    League
  rating    Float    @default(1500)
  updatedAt DateTime @updatedAt

  team      Team     @relation(fields: [teamId], references: [id])

  @@unique([teamId])
  @@index([league])
}

model KalshiMarket {
  id            String    @id @default(cuid())
  ticker        String    @unique
  title         String
  yesSubTitle   String?   // e.g. "Reg Time: Argentina" / "Reg Time: Tie" - the only
                          // reliable way to tell which outcome YES refers to on
                          // multi-outcome (3-way) markets, since `title` is shared
                          // across all of a game's outcome tickers.
  category      String?
  league        League?
  gameId        String?
  yesPrice      Float?    // cents, 0-100
  noPrice       Float?
  closeTime     DateTime?
  status        String?   // open/closed/settled per Kalshi
  // Prop-market fields. Null for moneyline / game-winner markets (the
  // default). Populated at sync time by the kalshi-props parser once Step 0
  // (live-verify) is done and we know the actual KXWCPLAYERGOALS /
  // KXWCTCORNERS ticker shape. Until then these stay null and the builder
  // branch in builder.ts sees null and falls through to the moneyline path.
  propKind              PropKind?
  propThreshold         Float?    // e.g. 0.5 for "0.5+ goals", 5.5 for "over 5.5 corners"
  propSubjectExternalId String?   // provider id (Player or Team) the prop grades on
  propSubjectName       String?   // denormalized for human-readable leg labels
  raw           String    @default("{}")
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  game          Game?     @relation(fields: [gameId], references: [id])
  legs          ParlayLeg[]

  @@index([league])
  @@index([gameId])
}

model Parlay {
  id                    String       @id @default(cuid())
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  status                ParlayStatus @default(PENDING)
  notes                 String?
  combinedProbability    Float?
  stake                 Float?
  source                String       @default("manual") // "suggestion" | "manual" | "kalshi"
  // Kalshi market ticker of the bet this parlay mirrors (a combo market like
  // KXMVECROSSCATEGORY-..., or a single market). Set by the Kalshi import, and
  // unique so re-importing updates the same row instead of duplicating it.
  externalId            String?      @unique
  payout                Float?       // dollars returned once settled (0 for a loss)

  legs                  ParlayLeg[]
}

model ParlayLeg {
  id                    String      @id @default(cuid())
  parlayId              String
  kalshiMarketId        String?
  gameId                String?
  description           String
  side                  MarketSide  @default(YES)
  // What this leg is grading on. Defaults to GAME_WINNER so existing rows
  // (created before prop legs existed) grade correctly under the new settle
  // code. The settlement route branches on this so a prop leg is never
  // silently routed through the game-winner path.
  legKind               LegKind     @default(GAME_WINNER)
  predictedProbability  Float
  marketImpliedProbability Float?
  actualOutcome         LegOutcome  @default(PENDING)
  settledAt             DateTime?
  createdAt             DateTime    @default(now())

  parlay                Parlay        @relation(fields: [parlayId], references: [id], onDelete: Cascade)
  kalshiMarket          KalshiMarket? @relation(fields: [kalshiMarketId], references: [id])
  game                  Game?         @relation(fields: [gameId], references: [id])
  featureLog            ModelFeatureLog?

  @@index([parlayId])
}

model ModelFeatureLog {
  id                    String     @id @default(cuid())
  parlayLegId           String     @unique
  league                League
  features              String     // JSON feature vector used for prediction
  predictedProbability  Float
  actualOutcome         LegOutcome
  createdAt             DateTime   @default(now())

  parlayLeg             ParlayLeg  @relation(fields: [parlayLegId], references: [id], onDelete: Cascade)

  @@index([league])
}

// Current injury report, replaced wholesale for a league on each sync. Only
// players with a non-zero chance of missing a game are stored; the model reads
// these to lower a team's effective Elo (see scoring/injuries.ts).
model InjuryReport {
  id               String   @id @default(cuid())
  league           League
  teamId           String
  playerExternalId String
  playerName       String
  position         String?
  status           String
  isStarter        Boolean? // null when no depth chart is available
  availabilityLoss Float    // chance the player misses the game, 0-1
  impactElo        Float    // Elo points lost if the player is out
  reportedAt       DateTime?
  fetchedAt        DateTime @default(now())

  @@index([league, teamId])
}

model ModelWeights {
  id          String   @id @default(cuid())
  league      League   @unique
  weights     String   // JSON: { coefficients: number[] }  -- no intercept, plain number array
  sampleSize  Int
  trainedAt   DateTime @default(now())
}
